{
  "name": "ink-harness",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "rm -rf dist && tauri dev",
    "tauri:build": "tauri build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:conventions": "node scripts/check-conventions.mjs && node scripts/check-guardrails-sync.mjs",
    "check:ub": "bash scripts/check-ub.sh",
    "check:ub:miri": "bash scripts/check-ub.sh miri",
    "check:ub:asan": "bash scripts/check-ub.sh asan",
    "check:all": "pnpm typecheck && pnpm lint && pnpm check:conventions && pnpm test && pnpm build",
    "push": "bash scripts/push.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@tiptap/vue-3": "^2.27.3",
    "naive-ui": "^2.45.3",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "sass": "^1.108.2",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-biome": "^1.2.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.0"
  }
}
